# Path to the local SQLite database file. Defaults to ./data/circuit.db.
CIRCUIT_DB_PATH=./data/circuit.db

# Where pipeline exports are written. Defaults to ./data/outputs.
CIRCUIT_OUTPUT_DIR=./data/outputs

# Anything at or above this final score enters the review queue.
CIRCUIT_MIN_REVIEW_SCORE=60

# ---------------------------------------------------------------------------
# Google Maps / Places API (Phase 2)
# ---------------------------------------------------------------------------
# Required to run the googleMapsSource. Leave blank to fail safely.
GOOGLE_PLACES_API_KEY=

# Cost controls — each search is one Places API Text Search request.
# 9 categories × 10 locations = 90 worst-case searches, so the default cap
# (20) keeps a single run inexpensive while you're tuning.
GOOGLE_MAPS_MAX_SEARCHES_PER_RUN=20
GOOGLE_MAPS_MAX_RESULTS_PER_SEARCH=20
GOOGLE_MAPS_MAX_LEADS_PER_RUN=200
GOOGLE_MAPS_REQUEST_TIMEOUT_MS=15000

# Set to "1" to force the in-memory mock provider even when an API key is
# present — useful for local development / CI.
GOOGLE_MAPS_FORCE_MOCK=0

# ---------------------------------------------------------------------------
# Website inspection (Phase 3)
# ---------------------------------------------------------------------------
# Master switch — set to 0 to skip inspection in the pipeline.
WEBSITE_INSPECTION_ENABLED=1
WEBSITE_INSPECTION_TIMEOUT_MS=10000
WEBSITE_INSPECTION_MAX_PAGES_PER_SITE=3
# Set to 1 to attempt the Playwright path (currently not implemented).
WEBSITE_INSPECTION_USE_PLAYWRIGHT=0
# Cached inspections older than this are refreshed on the next run.
WEBSITE_INSPECTION_CACHE_TTL_DAYS=7
# How many sites to inspect in parallel.
WEBSITE_INSPECTION_CONCURRENCY=4
# Optional override for the request User-Agent header.
# WEBSITE_INSPECTION_USER_AGENT="CircuitInspector/0.1"

# ---------------------------------------------------------------------------
# Evidence / proof extraction (Phase 9)
# Captures desktop + mobile screenshots and detects visual / operational
# issues. Uses Playwright (requires `npx playwright install chromium`).
# Off by default in the pipeline — run via `npm run extract:evidence`.
# ---------------------------------------------------------------------------
EVIDENCE_ENABLED=1
EVIDENCE_AUTO_RUN=0
EVIDENCE_TIMEOUT_MS=25000
EVIDENCE_MAX_LEADS_PER_RUN=25
EVIDENCE_CACHE_TTL_DAYS=14
EVIDENCE_SCREENSHOT_DIR=./data/screenshots
EVIDENCE_ALLOWED_CAMPAIGNS=AI_AUTOMATION,WEB_REBUILD,FUNNEL_OPTIMIZATION,LOCAL_DIGITAL_UPGRADE
EVIDENCE_ALLOWED_PRIORITIES=A,B

# ---------------------------------------------------------------------------
# Playwright fallback for JS-rendered contact pages (Phase 8.1)
# Only fires when the static crawl finds nothing useful OR the site looks
# like a JS-rendered shell (Wix / Squarespace / Webflow / Framer / etc.).
# ---------------------------------------------------------------------------
CONTACT_PLAYWRIGHT_FALLBACK_ENABLED=1
CONTACT_PLAYWRIGHT_MAX_PAGES_PER_COMPANY=3
CONTACT_PLAYWRIGHT_TIMEOUT_MS=12000

# ---------------------------------------------------------------------------
# Contact discovery (Phase 8)
# Crawl contact / about / team pages on already-discovered companies and
# extract emails + phones + decision-maker names. No paid enrichment by default.
# ---------------------------------------------------------------------------
CONTACT_DISCOVERY_ENABLED=1
CONTACT_DISCOVERY_MAX_PAGES_PER_SITE=4
CONTACT_DISCOVERY_TIMEOUT_MS=10000
CONTACT_DISCOVERY_CONCURRENCY=4
# Comma-separated allow-lists. Discovery only runs on leads whose primary
# campaign + priority match these.
CONTACT_DISCOVERY_ALLOWED_CAMPAIGNS=AI_AUTOMATION,WEB_REBUILD,FUNNEL_OPTIMIZATION,LOCAL_DIGITAL_UPGRADE
CONTACT_DISCOVERY_ALLOWED_PRIORITIES=A,B
# CONTACT_DISCOVERY_USER_AGENT="CircuitContacts/0.1"

# ---------------------------------------------------------------------------
# Selective AI analysis (Phase 5)
# Tiny, evidence-grounded operational analyses on top-priority leads only.
# Hard cost ceiling, hard lead cap, cache-first.
# ---------------------------------------------------------------------------
AI_ANALYSIS_ENABLED=1
AI_ANALYSIS_PROVIDER=anthropic
AI_ANALYSIS_MODEL=claude-haiku-4-5-20251001
AI_ANALYSIS_MAX_LEADS_PER_RUN=10
AI_ANALYSIS_ALLOWED_PRIORITIES=A
AI_ANALYSIS_DAILY_COST_LIMIT_USD=5
AI_ANALYSIS_MAX_INPUT_CHARS=12000
AI_ANALYSIS_MAX_OUTPUT_TOKENS=1500
AI_ANALYSIS_REQUEST_TIMEOUT_MS=30000
# Either ANTHROPIC_API_KEY or AI_PROVIDER_API_KEY is read. Leave blank to fall
# back to the deterministic mock provider with a warning.
ANTHROPIC_API_KEY=
# Set to 1 to force the mock provider even when a key is present.
AI_ANALYSIS_FORCE_MOCK=0
